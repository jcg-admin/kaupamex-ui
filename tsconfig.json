{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@app/*":        ["src/app/*"],
      "@modules/*":    ["src/modules/*"],
      "@components/*": ["src/components/*"],
      "@hooks/*":      ["src/hooks/*"],
      "@state/*":      ["src/state/*"],
      "@redux/*":      ["src/redux/*"],
      "@services/*":   ["src/services/*"],
      "@mocks/*":      ["src/mocks/*"],
      "@styles/*":     ["src/styles/*"],
      "@utils/*":      ["src/utils/*"],
      "@constants/*":  ["src/constants/*"],
      "@pages/*":      ["src/pages/*"],
      "@router/*":     ["src/router/*"],
      "@config/*":     ["src/config/*"],
      "@layouts/*":    ["src/layouts/*"],
      "@context/*":    ["src/context/*"],
      "@lib/*":        ["src/lib/*"],
      "@facades/*":    ["src/facades/*"],
      "@assets/*":     ["src/assets/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "build", "dist"]
}
